{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asri.example/schema/knowledge-object.schema.json",
  "title": "ASRI Knowledge Object",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "evidence_level", "domain", "definition", "claim", "not_evidence_of", "everyday_signals", "reflection_prompts", "decision_boundary", "source_ids", "last_reviewed"],
  "properties": {
    "id": {"type": "string", "pattern": "^KO-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 3},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["draft", "stable", "deprecated"]},
    "evidence_level": {"enum": ["A", "B", "C", "D"]},
    "domain": {"type": "string", "pattern": "^KM-[0-9]{2}$"},
    "definition": {"type": "string", "minLength": 20},
    "claim": {"type": "string", "minLength": 20},
    "not_evidence_of": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "everyday_signals": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reflection_prompts": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}},
    "decision_boundary": {"type": "string", "minLength": 20},
    "source_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[0-9]{3}$"}},
    "related_ids": {"type": "array", "items": {"type": "string", "pattern": "^KO-[0-9]{3}$"}, "uniqueItems": true},
    "notes": {"type": "string"},
    "last_reviewed": {"type": "string", "format": "date"}
  }
}
